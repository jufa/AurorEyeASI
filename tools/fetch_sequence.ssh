#!/usr/bin/env bash

# --- Configuration ---
REMOTE_USER="pi"
REMOTE_HOST="pi3-14.local" # change to the appropriate local host name for your rpi
REMOTE_PATH="/mnt/extstore"


# --- Get folder list and sizes in one SSH call ---
echo "Fetching folder list from ${REMOTE_USER}@${REMOTE_HOST}:${REMOTE_PATH} ..."

FOLDERS=()
SIZES=()
while IFS=$'\t' read -r size path; do
    folder="${path%/}"
    folder="${folder##*/}"
    FOLDERS+=("$folder")
    SIZES+=("$size")
done < <(ssh "${REMOTE_USER}@${REMOTE_HOST}" "du -sh ${REMOTE_PATH}/seq_*/ 2>/dev/null")

if [[ ${#FOLDERS[@]} -eq 0 ]]; then
    echo "No seq_ folders found at remote path. Exiting."
    exit 1
fi

# --- List folders with sizes ---
echo ""
echo "Available folders:"
echo "------------------"
for i in "${!FOLDERS[@]}"; do
    printf "  [%d] %s  (%s)\n" "$((i+1))" "${FOLDERS[$i]}" "${SIZES[$i]}"
done
echo ""

# --- User selection ---
while true; do
    read -rp "Enter folder number to download: " SELECTION
    if [[ "$SELECTION" =~ ^[0-9]+$ ]] && (( SELECTION >= 1 && SELECTION <= ${#FOLDERS[@]} )); then
        break
    fi
    echo "Invalid selection. Enter a number between 1 and ${#FOLDERS[@]}."
done

SELECTED_FOLDER="${FOLDERS[$((SELECTION-1))]}"

# --- Target directory ---
read -rp "Destination parent directory [${PWD}]: " TARGET_DIR
TARGET_DIR="${TARGET_DIR:-$PWD}"
TARGET_DIR="${TARGET_DIR/#\~/$HOME}"

if [[ ! -d "$TARGET_DIR" ]]; then
    read -rp "'${TARGET_DIR}' does not exist. Create it? [y/N]: " CONFIRM
    if [[ "$CONFIRM" =~ ^[Yy]$ ]]; then
        mkdir -p "$TARGET_DIR"
    else
        echo "Exiting."
        exit 1
    fi
fi

echo ""
echo "Downloading: ${SELECTED_FOLDER} -> ${TARGET_DIR}/"

# --- Download ---
rsync -avP -e "ssh -c aes128-gcm@openssh.com" \
    "${REMOTE_USER}@${REMOTE_HOST}:${REMOTE_PATH}/${SELECTED_FOLDER}" \
    "${TARGET_DIR}/"

if [[ $? -ne 0 ]]; then
    echo "rsync failed. Exiting."
    exit 1
fi

# --- Rename JPGs using exiftool DateTimeOriginal ---
echo ""
echo "Renaming JPGs using DateTimeOriginal..."

LOCAL_FOLDER="${TARGET_DIR}/${SELECTED_FOLDER}"
RENAMED=0
SKIPPED=0

for FILEPATH in "${LOCAL_FOLDER}"/*.jpg "${LOCAL_FOLDER}"/*.JPG; do
    [[ -f "$FILEPATH" ]] || continue

    BASENAME=$(basename "$FILEPATH")
    STEM="${BASENAME%.*}"

    DATETIME=$(exiftool -DateTimeOriginal -d "%Y%m%dT%H%M%S" -s3 "$FILEPATH" 2>/dev/null)

    if [[ -z "$DATETIME" ]]; then
        echo "  SKIP (no DateTimeOriginal): $BASENAME"
        ((SKIPPED++))
        continue
    fi

    NEWNAME="${STEM}_${DATETIME}.jpg"
    NEWPATH="${LOCAL_FOLDER}/${NEWNAME}"

    mv "$FILEPATH" "$NEWPATH"
    echo "  $BASENAME -> $NEWNAME"
    ((RENAMED++))
done

echo ""
echo "Done. Renamed: ${RENAMED}  Skipped: ${SKIPPED}"
